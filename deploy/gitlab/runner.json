                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "traefik"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8443
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "runner-manager-api",
        "namespace": "verjson-runners"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "verjson-gitlab-runner"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [],
        "egress": [
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "159.195.78.163/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "10.43.0.1/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 6443
              },
              {
                "protocol": "TCP",
                "port": 443
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "verjson-gitlab-runner",
        "namespace": "verjson-runners"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "verjson-gitlab-runner"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "verjson-gitlab-runner"
            }
          },
          "spec": {
            "serviceAccountName": "verjson-gitlab-runner",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1001,
              "runAsGroup": 1001,
              "fsGroup": 1001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "imagePullSecrets": [
              {
                "name": "nexus-manager-pull"
              }
            ],
            "initContainers": [
              {
                "image": "docker.nexus.159-195-78-163.nip.io/verjson/gitlab-runner/manager@sha256:07f924e39aefc1f4ce49e2d7e83b31dedd1a8f07a172b2fe3a9175072bd9d92b",
                "imagePullPolicy": "Always",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "name": "config",
                "command": [
                  "/bin/sh",
                  "-c",
                  "cp /source/config.toml /config/config.toml; chmod 600 /config/config.toml"
                ],
                "volumeMounts": [
                  {
                    "name": "config-source",
                    "mountPath": "/source",
                    "readOnly": true
                  },
                  {
                    "name": "config",
                    "mountPath": "/config"
                  }
                ]
              }
            ],
            "containers": [
              {
                "image": "docker.nexus.159-195-78-163.nip.io/verjson/gitlab-runner/manager@sha256:07f924e39aefc1f4ce49e2d7e83b31dedd1a8f07a172b2fe3a9175072bd9d92b",
                "imagePullPolicy": "Always",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  }
                },
                "name": "runner",
                "command": [
                  "/usr/bin/gitlab-runner",
                  "run",
                  "--config",
                  "/config/config.toml",
                  "--working-directory",
                  "/work"
                ],
                "env": [
                  {
                    "name": "HOME",
                    "value": "/work"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/config"
                  },
                  {
                    "name": "work",
                    "mountPath": "/work"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "config-source",
                "secret": {
                  "secretName": "verjson-gitlab-runner-config",
                  "defaultMode": 288
                }
              },
              {
                "name": "config",
                "emptyDir": {}
              },
              {
                "name": "work",
                "emptyDir": {}
              },
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    }
  ]
